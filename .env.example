# --- Server ---

# Port for `pnpm dev` and `pnpm start`.
OP_PORT=5002

# Platform API: `pnpm dev` proxies /api/v1/* to it for local sign-in, and
# `pnpm update:restapi` and `pnpm update:pyapi:models` read specs and the models listing from it.
OP_SERVER_PROXY=

# --- Tooling ---

# Unpublished SDK repository the Python reference installs from (`pnpm update:pyapi`).
OP_SDK_GIT_URL=



# --- Public, inlined at build time ---

# Origin for canonical URLs, the sitemap and OG images.
NEXT_PUBLIC_OP_SITE_URL=https://docs.openprotein.ai

# Web app the header links to; sign-in goes through it.
NEXT_PUBLIC_OP_APP_URL=

# Platform API for the models catalogue, sign-in and the playground.
# Sign-in and the playground also need the app URL.
NEXT_PUBLIC_OP_API_URL=

# Google Analytics 4 measurement ID.
NEXT_PUBLIC_OP_GA_ID=

# Repo and branch for "Open in GitHub" and the notebook badges.
NEXT_PUBLIC_OP_REPO=
NEXT_PUBLIC_OP_REPO_BRANCH=main

