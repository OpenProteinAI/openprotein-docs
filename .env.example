# Platform API. Mirrors the web app: VITE_APP_SERVER_PROXY / VITE_APP_SERVER_ROOT_API.
OP_SERVER_PROXY=https://dev.api.openprotein.ai
OP_SERVER_ROOT_API=/api/v1/

# Session cookie key (JWE, A256GCM). Must be >= 32 bytes: openssl rand -base64 32
DOCS_SESSION_SECRET=replace-me

# Google Analytics 4 (carried over from the Sphinx site)
NEXT_PUBLIC_GA_ID=G-SS7ET8W19C

# Branch the content lives on, for "Edit this page" and the notebook badges.
# Set to develop once phap/new-docs merges.
NEXT_PUBLIC_CONTENT_REF=phap/new-docs

# Absolute origin for canonical URLs, the sitemap, robots and OG images.
NEXT_PUBLIC_SITE_URL=https://docs.openprotein.ai
