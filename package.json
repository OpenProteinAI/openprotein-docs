{
  "name": "openprotein-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node ./scripts/next.mjs dev",
    "build": "next build && node ./scripts/csp-static.mjs",
    "start": "node ./scripts/next.mjs start",
    "types:check": "next typegen && tsc --noEmit",
    "update:restapi": "node ./scripts/update-restapi.mjs",
    "update:pyapi": "node ./scripts/update-pyapi.mjs",
    "update:pyapi:models": "node ./scripts/update-pyapi.mjs --models",
    "check:restapi": "node ./scripts/check-restapi.mjs",
    "check:live-openapi": "node --test ./scripts/check-live-openapi.mjs",
    "check:live-openapi:browser": "node ./scripts/check-live-openapi-browser.mjs",
    "check:model-bibtex": "node --test ./scripts/check-model-bibtex.mjs",
    "check:auth": "node ./scripts/check-auth.mjs",
    "check:proxy": "node ./scripts/check-dev-proxy.mjs",
    "check:pyapi:unit": "node --test scripts/check-pyapi-contract.mjs && .venv-pyapi/bin/python -m unittest discover -s scripts/pyapi/tests -v",
    "check:pyapi": "node ./scripts/check-pyapi.mjs",
    "check:mdx": "node ./scripts/check-mdx.mjs",
    "check:links": "node ./scripts/check-links.mjs",
    "check:github": "node ./scripts/check-github.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "1.8.1",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@next/third-parties": "^16.3.3",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-tooltip": "1.2.16",
    "fumadocs-core": "16.19.3",
    "fumadocs-mdx": "15.6.2",
    "fumadocs-openapi": "11.4.3",
    "fumadocs-ui": "16.19.3",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "hastscript": "9.0.1",
    "lucide-react": "^1.28.0",
    "lz-string": "1.5.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "11.0.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/estree": "^1.0.10",
    "@types/estree-jsx": "^1.0.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
