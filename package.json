{
  "name": "openprotein-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-5001}",
    "build": "next build",
    "start": "next start --port ${PORT:-5001}",
    "types:check": "next typegen && tsc --noEmit",
    "sync:specs": "node ./scripts/sync-specs.mjs",
    "check:specs": "node ./scripts/sync-specs.mjs --check",
    "sync:pyapi": ".venv-pyapi/bin/python ./scripts/pyapi/generate.py",
    "check:pyapi": ".venv-pyapi/bin/python ./scripts/pyapi/generate.py --check",
    "diff:pyapi": ".venv-pyapi/bin/python ./scripts/pyapi/generate.py --diff",
    "upstream:pyapi": ".venv-pyapi/bin/python ./scripts/pyapi/generate.py --upstream",
    "check:pyapi:upstream": ".venv-pyapi/bin/python ./scripts/pyapi/generate.py --upstream --check",
    "verify:pyapi:pin": ".venv-pyapi/bin/python ./scripts/pyapi/generate.py --verify-pin",
    "check:contrast": "node ./scripts/check-contrast.mjs",
    "check:layout": "node ./scripts/geom.mjs",
    "shots": "node ./scripts/shots.mjs",
    "check:restapi": "node ./scripts/check-restapi.mjs",
    "check:pyapi:render": "node ./scripts/check-pyapi.mjs",
    "check:mdx": "node ./scripts/check-mdx.mjs",
    "check:content": "node ./scripts/check-content.mjs",
    "check:auth": "node ./scripts/check-auth.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.14.3",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-openapi": "11.2.3",
    "fumadocs-ui": "16.14.3",
    "github-slugger": "^2.0.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
