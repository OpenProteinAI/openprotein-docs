    "tags": [
     "assaydata"
    ],
    "summary": "Upload data for use with our platform",
    "description": "Upload assay data for use with core OpenProtein tools.\n\nAccepts either:\n* CSV with a sequence column and 0+ measurement columns\n  (missing values allowed); mutation codes are also accepted, and\n* FASTA with one record per variant (sequence-only — no measurements).\n\n---\n\nArgs:\n    assay_data (UploadFile): File to upload to OpenProtein (CSV or FASTA).\n    assay_name (str, optional): assay name.\n    assay_description (str, optional): description.\n    replicate_mapping (Optional[str]): JSON map of replicate group -> columns.\n    parent_sequence (Optional[str]): parent sequence for the assay.\n    project_uuid (Optional[str]): unique id for project.\n    current_user (User): authenticated user.\n    error_limits (int): cap on the number of detail entries in errors.\n\nRaises:\n    HTTPException: invalid formats.\n\nReturns:\n    json: assay metadata",
    "operationId": "create_assay_data_api_v1_assaydata_post",
    "security": [
     {
      "OAuth2PasswordBearer": []
     }
    ],
    "parameters": [
     {
      "name": "parent_sequence",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Parent Sequence"
      }
     },
     {
      "name": "project_uuid",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
